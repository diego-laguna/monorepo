{
    "name": "@repo/grpc",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true proto/*.proto"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.10.0",
        "google-protobuf": "^3.21.2"
    },
    "devDependencies": {
        "ts-proto": "^1.170.1"
    }
}